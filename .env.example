# Local é uma aplicação completa no navegador, sem enviar arquivos ao servidor.
VITE_STORAGE_MODE=local
VITE_APP_NAME=Detalha
# Para usar a autenticação e o backend Firebase, mudar o modo para firebase.
# Configuração WEB pública: copiar do aplicativo web no Console do Firebase.
# Nunca colocar a conta de serviço neste arquivo ou em variáveis VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=personalizacao-stand.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=personalizacao-stand
VITE_FIREBASE_STORAGE_BUCKET=personalizacao-stand.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1
VITE_WORKSPACE_ID=uset
VITE_USE_EMULATORS=false
